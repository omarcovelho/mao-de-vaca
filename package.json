{
  "name": "mao-de-vaca",
  "version": "0.0.1",
  "private": true,
  "description": "Controle pessoal de gastos e receitas",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "scripts": {
    "dev": "concurrently -n server,ui -c blue,green \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:server": "node --env-file=.env ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "dev:ui": "vite --config src/ui/vite.config.ts",
    "build": "npm run build:ui && npm run build:server",
    "build:ui": "vite build --config src/ui/vite.config.ts",
    "build:server": "nest build",
    "start": "node --env-file=.env dist/server/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "lint": "eslint src/server src/ui --fix",
    "lint:ci": "eslint",
    "test": "npm run test:server",
    "test:server": "jest --config jest.config.cjs",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "node --env-file=.env prisma/seed.js"
  },
  "lint-staged": {
    "src/server/**/*.ts": "eslint --fix",
    "src/ui/**/*.{ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^15.5.2",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.0"
  }
}
